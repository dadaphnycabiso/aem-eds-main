              { "value": "text-body-small", "label": "Body 2" },
              { "value": "text-body-small-medium", "label": "Body 2 Medium" },
              { "value": "text-caption", "label": "Caption" },
              { "value": "text-caption-medium", "label": "Caption Medium" }
